# Local demo defaults (no secrets). Connected adapters are opt-in.
HEALTHCARE_MODE=local
AGENT_MODE=synthetic

# Optional Medplum connected mode (server-only; never NEXT_PUBLIC_)
# MEDPLUM_BASE_URL=https://api.medplum.com
# MEDPLUM_CLIENT_ID=
# MEDPLUM_CLIENT_SECRET=
# MEDPLUM_PROJECT_ID=

# Optional Breakfast Factory BFF mode (server-only)
# BFF_BASE_URL=
# BFF_API_KEY=

# Optional Stedi test-mode eligibility connection (server-only)
# STEDI_MODE=test
# STEDI_API_KEY=
# STEDI_BASE_URL=https://healthcare.us.stedi.com

# Optional Moss live semantic retrieval (server-only, synthetic corpus only)
# MOSS_MODE=live
# MOSS_PROJECT_ID=
# MOSS_PROJECT_KEY=
# MOSS_INDEX_NAME=overturn-claims-demo-v1
# MOSS_EXECUTION=cloud
# For hosted web deployments, use the authenticated AWS local-search sidecar.
# MOSS_EXECUTION=sidecar
# MOSS_SIDECAR_URL=https://your-bff-host.example/v1/moss/query
# MOSS_SIDECAR_API_KEY=
